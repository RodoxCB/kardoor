generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContratoStatus {
  RASCUNHO
  ATIVO
  CONCLUIDO
  CANCELADO
}

enum PagamentoStatus {
  AGUARDANDO
  LIBERADO
  BLOQUEADO
}

model Motorista {
  id            Int                  @id @default(autoincrement())
  nome          String
  documento     String               @unique
  veiculo       String
  status        ContratoStatus       @default(RASCUNHO)
  valorEsperado Float?
  contratos     ContratoAdesivacao[]
  criadoEm      DateTime             @default(now())
  atualizadoEm  DateTime             @updatedAt
}

model Anunciante {
  id           Int                  @id @default(autoincrement())
  nome         String
  email        String               @unique
  contratos    ContratoAdesivacao[]
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
}

model ContratoAdesivacao {
  id             Int                  @id @default(autoincrement())
  motorista      Motorista            @relation(fields: [motoristaId], references: [id])
  motoristaId    Int
  anunciante     Anunciante           @relation(fields: [anuncianteId], references: [id])
  anuncianteId   Int
  areaBonificada Float
  valor          Float
  kmsMeta        Float
  duracaoDias    Int
  inicio         DateTime
  fimPrevisto    DateTime
  status         ContratoStatus       @default(RASCUNHO)
  kmrRegistros   KMRRegistro[]
  parceiro       ParceiroVerificacao?
  pagamento      Pagamento?
  campanha       CampanhaAnunciante?
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt
}

model KMRRegistro {
  id                Int                @id @default(autoincrement())
  contrato          ContratoAdesivacao @relation(fields: [contratoId], references: [id])
  contratoId        Int
  timestamp         DateTime           @default(now())
  quilometros       Float
  areaBonificada    Boolean            @default(false)
  duracaoAtualizada Int
  localizacao       String?
}

model ParceiroVerificacao {
  id            Int                @id @default(autoincrement())
  parceiroId    String
  contrato      ContratoAdesivacao @relation(fields: [contratoId], references: [id])
  contratoId    Int                @unique
  checkinInicio DateTime
  checkinFim    DateTime?
  integridade   String             @default("pendente")
  fotos         String?
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt
}

model CampanhaAnunciante {
  id                Int                @id @default(autoincrement())
  contrato          ContratoAdesivacao @relation(fields: [contratoId], references: [id])
  contratoId        Int                @unique
  tipoMidia         String
  investimento      Float
  relatoriosGerados Int                @default(0)
  impactoEstimado   String?
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
}

model Pagamento {
  id               Int                @id @default(autoincrement())
  contrato         ContratoAdesivacao @relation(fields: [contratoId], references: [id])
  contratoId       Int                @unique
  statusPix        PagamentoStatus    @default(AGUARDANDO)
  pontosAcumulados Int                @default(0)
  valorLiberado    Float?
  dataPagamento    DateTime?
}
